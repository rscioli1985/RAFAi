# Application
APP_ENV=development
LOG_LEVEL=INFO

# API Auth (MVP)
API_KEY=change-me

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/nilrag

# Vector settings
VECTOR_DIM=1536
VECTOR_INDEX_LISTS=100

# Secrets & config (absolute paths outside repo)
SECRETS_DIR=/ABSOLUTE/PATH/TO/secrets
REDDIT_SECRETS_FILE=/ABSOLUTE/PATH/TO/secrets/reddit.yaml
LLM_SECRETS_FILE=/ABSOLUTE/PATH/TO/secrets/llm.yaml

# Models (defaults; adjust per provider)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Ingestion
SUBREDDITS="exampleSub1+exampleSub2+exampleSub3"
BACKFILL_DAYS=30
MAX_SUBREDDITS_PER_JOB=10
MAX_KEYWORDS_PER_JOB=50
LLM_DAILY_BUDGET_CENTS=5000
FEATURE_RUN_SCRAPE=true
FEATURE_REANALYZE=true
FEATURE_REEMBED=true
